                                     20         ;; load constants on a pair of Z80 registers
                                     21         .macro ldcst reg,car,cdr
                                     22         ld      'reg', (('car') << 8) | ('cdr')
                                     23         .endm
                                     24 
                                     25         ;; load constants on a pair of Z80 registers
                                     26         .macro init_unused_cmd_jmptable
                                     27 cmd_jmptable_padding:
                                     28         ;; fill remaining commands if any
                                     29         .rept   128-((cmd_jmptable_padding - cmd_jmptable)/3)
                                     30         jp      snd_command_unused
                                     31         .endm
                                     32         .endm
                                     33 
                                     34         ;; nullsound ID, stored in the beginning of the sound ROM
                                     35         .macro  nullsound_id
                                     36         .ascii  %nullsound v0.2.0 - https://github.com/dciabrin/ngdevkit%
                                     37         .endm
                                     38 
                                     39         ;; private helper to generate z80 opcode to stay idle in RAM
                           00FFFE    40         .lclequ RESET_WAIT_PC,0xfffe
                           00FE18    41         .lclequ OPCODE_JR_TO_SELF,0xfe18
                                     42         .macro  prepare_wait_in_ram_opcodes
                                     43         ;; create a jmp-to-self instruction at the top of the RAM
                                     44         ;; to ensure the 68k can bank-switch z80 code without impact
                                     45         ld      bc, #OPCODE_JR_TO_SELF     ; jr <self>
                                     46         ld      (#RESET_WAIT_PC), bc
                                     47         ;; ;; prepare the stack to pop into the jump-to-self in RAM
                                     48         ld      hl, #0xfffe
                                     49         ld      sp, hl
                                     50         push    hl
                                     51         .endm
                                     52 
                                     53         ;; address of an optional hook function that gets called
                                     54         ;; once the driver finished its initialization
                           00FFFE    55         .lclequ POST_INIT_HOOK, RESET_WAIT_PC
                                     24 
                                     25         .area   CODE
                                     26 
                                     27 
                                     28 ;;; The M-ROM must provide a jump table to all sound commands
                                     29 ;;; The jump table includes command 01 and 03 which are
                                     30 ;;; implemented by nullsound.
                                     31 ;;; If relies on a new
                                     32 ;;;
                                     33 
      000000                         34 cmd_jmptable::
                                     35         ;; common/reserved sound commands
      000000 C3 00 00         [10]   36         jp      snd_command_unused
      000003 C3 00 00         [10]   37         jp      snd_command_01_prepare_for_rom_switch
      000006 C3 00 00         [10]   38         jp      music_ngdevkit_eye_catcher
      000009 C3 00 00         [10]   39         jp      snd_command_03_reset_driver
                                     40         ;; complete unused sound commands
      00000C                         41         init_unused_cmd_jmptable
      00000C                          1 cmd_jmptable_padding:
                                      2         ;; fill remaining commands if any
                                      3         .rept   128-((cmd_jmptable_padding - cmd_jmptable)/3)
                                      4         jp      snd_command_unused
                                      5         .endm
      00000C C3 00 00         [10]    1         jp      snd_command_unused
                                      2         .endm
