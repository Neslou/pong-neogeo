                                     19 ;;; Simple function definition to play the ngdevkit eye catcher jingle
                                     20 
                                     21         .area   CODE
                                     22 
      000000                         23 music_ngdevkit_eye_catcher::
      000000 CD 00 00         [17]   24         call    snd_stream_stop
      000003 01 00 00         [10]   25         ld      bc, #instruments_ngdevkit
      000006 11 00 00         [10]   26         ld      de, #nss_ngdevkit
      000009 CD 00 00         [17]   27         call    snd_stream_play
      00000C C9               [10]   28         ret
